APP_ENVIRONMENT=development
APP_HTTP_PORT=8000
APP_DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment
APP_ARTIFACT_DIRECTORY=.artifacts
APP_SUBMISSION_MODE=review
APP_BROWSER_HEADLESS=true
APP_BROWSER_TIMEOUT_MS=30000
APP_BROWSER_STATE_ENCRYPTION_KEY=
APP_ENABLE_HEADHUNTER_APPLY=false
APP_ENABLE_LINKEDIN_APPLY=false
APP_MAX_BROWSER_STATE_BYTES=2097152
APP_GLOBAL_BROWSER_CONCURRENCY=2
# Required when APP_ENVIRONMENT=production. Generate a long random value.
APP_API_KEY=
# Alternative for least-privilege clients: JSON mapping secret keys to scope lists.
# APP_API_CLIENTS_JSON={"replace-with-secret":["review:read"]}
APP_REDIS_URL=redis://localhost:6379/0

# ============================================================
# OpenSearch (rebuildable matching projection)
# ============================================================
APP_OPENSEARCH_URL=http://localhost:9200
APP_OPENSEARCH_EVIDENCE_INDEX_PREFIX=candidate-evidence
APP_OPENSEARCH_EVIDENCE_READ_ALIAS=candidate-evidence-read
APP_OPENSEARCH_EVIDENCE_WRITE_ALIAS=candidate-evidence-write

# ============================================================
# Matching v2
# ============================================================
APP_MATCHING_V2_ENABLED=true
APP_MATCHING_V2_SHADOW_MODE=true
APP_MATCHING_V2_FALLBACK_ENABLED=true
APP_MATCHING_MODEL_TIMEOUT_SECONDS=120

# ============================================================
# Embedding service (required for matching v2 retrieval)
# Provides vector embeddings for evidence indexing and search.
# From JSA containers on Docker Desktop use http://host.docker.internal:8090.
# ============================================================
APP_EMBEDDING_SERVICE_URL=http://host.docker.internal:8090
APP_EMBEDDING_DIMENSIONS=1024
# Legacy alias; APP_EMBEDDING_SERVICE_URL takes precedence when set.
APP_MATCHING_MODEL_SERVICE_URL=http://localhost:8090

# ============================================================
# External Reranker service (optional, improves ranking quality)
# When both URL and key are set, matching uses the reranker.
# When either is empty, matching falls back to hybrid scores.
# From JSA containers on Docker Desktop use http://host.docker.internal:8200.
# Use the service key, never the admin token.
# ============================================================
APP_RERANKER_SERVICE_URL=http://host.docker.internal:8200
APP_RERANKER_API_KEY=

# ============================================================
# External RAG service (optional, context enrichment)
# Provides retrieval-augmented generation for matching context.
# Requires: service URL, API key, and project ID.
# From JSA containers on Docker Desktop use http://host.docker.internal:8100.
# ============================================================
APP_RAG_ENABLED=true
APP_RAG_SERVICE_URL=http://host.docker.internal:8100
APP_RAG_API_KEY=
APP_RAG_PROJECT_ID=
APP_RAG_COLLECTION=default
APP_RAG_TIMEOUT_SECONDS=15

# ============================================================
# Worker
# ============================================================
APP_WORKER_LEASE_SECONDS=120
APP_WORKER_POLL_SECONDS=2
APP_WORKER_RETRY_SECONDS=30
APP_WORKER_MAX_ATTEMPTS=3
APP_MAX_DOCUMENT_BYTES=5242880
APP_MAX_EVIDENCE_BYTES=10485760
APP_RETENTION_DAYS=30
APP_RETENTION_INTERVAL_SECONDS=86400

# ============================================================
# HeadHunter
# ============================================================
# Set a real contact address before shared/production HeadHunter API use.
APP_HH_USER_AGENT=JobSearchingAssistant/1.0 (contact@example.com)
# Optional OAuth bearer token. Never commit a real value.
APP_HH_ACCESS_TOKEN=

# ============================================================
# LLM providers (for resume analysis and cover letters)
# ============================================================
APP_ANTHROPIC_API_KEY=
APP_GEMINI_API_KEY=
