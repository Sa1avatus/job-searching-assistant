APP_ENVIRONMENT=development
APP_DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment
APP_ARTIFACT_DIRECTORY=.artifacts
APP_SUBMISSION_MODE=review
APP_BROWSER_HEADLESS=true
APP_BROWSER_TIMEOUT_MS=30000
APP_BROWSER_STATE_ENCRYPTION_KEY=
APP_ENABLE_HEADHUNTER_APPLY=false
APP_ENABLE_LINKEDIN_APPLY=false
APP_MAX_BROWSER_STATE_BYTES=2097152
APP_GLOBAL_BROWSER_CONCURRENCY=2
# Required when APP_ENVIRONMENT=production. Generate a long random value.
APP_API_KEY=
# Alternative for least-privilege clients: JSON mapping secret keys to scope lists.
# APP_API_CLIENTS_JSON={"replace-with-secret":["review:read"]}
APP_REDIS_URL=redis://localhost:6379/0
APP_WORKER_LEASE_SECONDS=120
APP_WORKER_POLL_SECONDS=2
APP_WORKER_RETRY_SECONDS=30
APP_WORKER_MAX_ATTEMPTS=3
APP_MAX_DOCUMENT_BYTES=5242880
APP_MAX_EVIDENCE_BYTES=10485760
APP_RETENTION_DAYS=30
APP_RETENTION_INTERVAL_SECONDS=86400
# Set a real contact address before shared/production HeadHunter API use.
APP_HH_USER_AGENT=JobSearchingAssistant/0.1 (contact@example.com)
# Optional OAuth bearer token. Never commit a real value.
APP_HH_ACCESS_TOKEN=
# Optional LLM provider used for resume analysis and individual cover letters.
APP_ANTHROPIC_API_KEY=
APP_GEMINI_API_KEY=
